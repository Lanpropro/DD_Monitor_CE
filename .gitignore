# 运行期产生的东西，不进版本库
__pycache__/
*.pyc
logs/
cache/
recordings/
utils/config.json
utils/config.json.bak
dev/preview/

# 打包 / 临时工作目录（dev/build_release.ps1、PyInstaller 的中间产物都放这儿）
work/
# 发布产物（用户习惯把 zip 收在这里）。
# 写成 `results/*` 而不是 `results/`：这样 results/.gitignore 自己能进版本库，
# 而里面的 zip / exe / 源码包一律不进（目录自带的那份也是同样的规则）。
results/*
!results/.gitignore

# 虚拟环境
.venv/
venv/

# VLC 运行库（体积大，从原仓库或 VLC 安装目录取，见 README）
*.dll
plugins/

# 插件：用户插件放 plugins_user/
# 只忽略插件自己产生的数据目录；`_template_platform` 这种「下划线开头 = 不自动装载」
# 的模板是要进版本库的，所以不能写成 plugins_user/_*/
plugins_user/_danmaku_log/

# 宣传片参考素材：别人的视频，只用来对风格，不进版本库
Video_reference/

# 宣传片项目本体：素材很大（单文件最大 24 MB，`.git` 一度涨到 987 MB），只在本机
# 拍 / 剪，不进版本库、也不进发布包 —— dev/build_release.ps1 是按 git ls-files 打的
videos/

# 内部交接文档与状态记录：给自己看的，不进版本库 / 发布包
HANDOFF-*.md
PROJECT_STATE.md

# 随手笔记
idea.txt

# 编辑器
.vscode/
.idea/
.DS_Store
